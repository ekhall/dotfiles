;; Minibuffer history file, automatically generated by ‘savehist’.

(setq savehist-minibuffer-history-variables '(buffer-name-history yes-or-no-p-history minibuffer-history file-name-history extended-command-history))
(setq buffer-name-history '("config.org"))
(setq yes-or-no-p-history '("yes"))
(setq minibuffer-history '("marginalia" "orderless" "vertico" "doom-themes"))
(setq file-name-history '("~/.emacs.d/init.el" "~/.emacs.d/config.org" "~/.emacs.d/" "~/.emacs.d/config.org" "~/.emacs.d/custom.el" "~/.emacs.d/" "~/.emacs.d/init.el"))
(setq extended-command-history '("package-upgrade-all" "package-refresh-contents" "package-install" "package-refresh-contents"))
